&CONTROL
    calculation = 'scf',
    prefix = 'si5_ecut45',
    pseudo_dir = 'pseudopotentials/',
    outdir = './tmp/',
    tprnfor = .true.,
    tstress = .false.,
    etot_conv_thr = 1.0D-5,
/

&SYSTEM
    ibrav = 0,
    nat = 5,
    ntyp = 1,
    ecutwfc = 45.0,
    ecutrho = 360.0,
    occupations = 'fixed',
    nosym = .true.,
/

&ELECTRONS
    conv_thr = 1.0D-10,
    electron_maxstep = 100,
    mixing_beta = 0.7,
/

ATOMIC_SPECIES
    Si   28.0855   Si.pbe-nl-rrkjus_psl.UPF

CELL_PARAMETERS angstrom
    20.0   0.0    0.0
     0.0  20.0    0.0
     0.0   0.0   20.0

ATOMIC_POSITIONS angstrom
Si       8.0206542141     8.0206544793     8.0206545709
Si      10.3255522469     8.1572241413     8.1572243041
Si       8.1572244169    10.3255523588     8.1572240192
Si       8.1572243007     8.1572242350    10.3255524051
Si       9.7393448214     9.7393447856     9.7393447007

K_POINTS gamma
