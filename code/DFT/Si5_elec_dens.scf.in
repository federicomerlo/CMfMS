&CONTROL
    calculation = 'scf',
    prefix = 'si5_scf_density',
    pseudo_dir = 'pseudopotentials/',
    outdir = './tmp/',
    tprnfor = .true.,
    tstress = .false.,
/

&SYSTEM
    ibrav = 0,
    nat = 5,
    ntyp = 1,
    ecutwfc = 45.0,
    ecutrho = 360.0,
    occupations = 'fixed',
    nosym = .true.,
/

&ELECTRONS
    conv_thr = 1.0D-10,
    electron_maxstep = 100,
    mixing_beta = 0.7,
/

ATOMIC_SPECIES
    Si   28.0855   Si.pbe-nl-rrkjus_psl.UPF

CELL_PARAMETERS angstrom
    16.0   0.0    0.0
     0.0  16.0    0.0
     0.0   0.0   16.0

ATOMIC_POSITIONS angstrom
Si               8.1708741046        8.2064800926        8.1671719694
Si              10.4799542775        8.3388714731        8.1736134568
Si               8.3190348853       10.5061066341        8.3632282180
Si               8.4410417314        8.2749938459       10.4631452656
Si               9.9890950012        9.8735479543        9.8328410903

K_POINTS gamma
